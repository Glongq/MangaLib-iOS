name: iOS

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-26
    steps:
      - uses: actions/checkout@v4

      - name: Select Xcode 26
        run: |
          ls /Applications | grep -i Xcode || true
          sudo xcode-select -s /Applications/Xcode_26.app || sudo xcode-select -s /Applications/Xcode.app
          xcodebuild -version

      - name: Install XcodeGen
        run: brew install xcodegen

      - name: Generate Xcode project
        run: xcodegen generate

      - name: List Xcode project targets and schemes
        run: xcodebuild -list -project MangaLib.xcodeproj

      - name: Build for device (unsigned)
        run: |
          set -euo pipefail
          mkdir -p build
          xcodebuild \
            -project MangaLib.xcodeproj \
            -scheme MangaLib \
            -sdk iphoneos \
            -destination 'generic/platform=iOS' \
            -configuration Debug \
            -derivedDataPath build/DerivedData \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_IDENTITY="" \
            DEVELOPMENT_TEAM="" \
            ONLY_ACTIVE_ARCH=NO \
            build \
            | tee build/xcodebuild.log

      - name: Print build output diagnostics
        run: |
          set +e
          echo "=== pwd ==="
          pwd
          echo "=== xcodebuild -version ==="
          xcodebuild -version
          echo "=== find build -name \"*.app\" ==="
          find build -name "*.app"
          echo "=== find build -name \"MangaLib\" ==="
          find build -name "MangaLib"
          echo "=== find build -type f | head -100 ==="
          find build -type f | head -100
          echo "=== du -sh build ==="
          du -sh build
          echo "=== du -sh build/DerivedData ==="
          du -sh build/DerivedData
          echo "=== ls -R build/DerivedData/Build/Products ==="
          ls -R build/DerivedData/Build/Products


      - name: Upload MangaLib.app.zip

        uses: actions/upload-artifact@v4:
        with:
          name: MangaLib-Debug-iphoneos
          path: build/MangaLib.app.zip
          if-no-files-found: error
